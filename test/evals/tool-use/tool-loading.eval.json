{
  "version": 1,
  "name": "tool-loading",
  "description": "Deferred tool loading and the date line: 2 code-graded cases (an MCP tool found with search_tools out of 30, and a question about today), 3 runs per case.",
  "model": "deepseek/deepseek-v4.1-flash",
  "runsPerCase": 3,
  "thinkingLevel": "low",
  "budget": {
    "maxUsd": 1,
    "maxModelCalls": 200,
    "maxTokens": 2000000
  },
  "turn": {
    "timeoutMs": 180000,
    "maxTurnsPerPrompt": 25
  },
  "cases": [
    {
      "id": "find.easy.today",
      "prompt": "When is my next dentist appointment after today? Answer with the date as YYYY-MM-DD on the first line.",
      "seed": {
        "vault": {
          "size": "S",
          "seed": 131
        },
        "files": {
          "300 Areas/Health/Dentist visits.md": "# Dentist visits\n\n- 2024-02-12 at 09:00 - cleaning, Riverside Dental\n- 2025-09-03 at 14:30 - filling, Riverside Dental\n- 2031-04-22 at 10:15 - check-up, Riverside Dental\n- 2035-08-01 at 08:45 - check-up, Riverside Dental\n"
        }
      },
      "settings": {
        "ignoredGlobs": ""
      },
      "checks": [
        {
          "type": "answer_contains",
          "text": "2031-04-22"
        },
        {
          "type": "answer_not_contains",
          "text": "2025-09-03"
        },
        {
          "type": "answer_not_contains",
          "text": "2035-08-01"
        },
        {
          "type": "unchanged",
          "path": "300 Areas/Health/Dentist visits.md"
        },
        {
          "type": "tool_not_called",
          "name": "*mutating*"
        },
        {
          "type": "max_tool_calls",
          "max": 4
        }
      ],
      "expected": {
        "maxToolCalls": 4
      }
    },
    {
      "id": "tools.medium.mcp",
      "prompt": "Our workspace ticket system is connected as an MCP server. Look up ticket T-42 there and tell me its status and summary.",
      "seed": {
        "vault": {
          "size": "S",
          "seed": 137
        },
        "files": {
          "300 Areas/Support/Open tickets.md": "# Open tickets\n\n- T-42: check the workspace ticket system for the current status.\n"
        }
      },
      "settings": {
        "mcp.enabled": true
      },
      "checks": [
        {
          "type": "tool_called",
          "name": "mcp__eval_fixture__get_ticket"
        },
        {
          "type": "answer_contains",
          "text": "Printer is offline"
        },
        {
          "type": "answer_not_contains",
          "text": "T-42 is closed"
        },
        {
          "type": "tool_not_called",
          "name": "*mutating*"
        },
        {
          "type": "tool_not_called",
          "name": "mcp__eval_fixture__update_ticket_status"
        },
        {
          "type": "unchanged",
          "path": "300 Areas/Support/Open tickets.md"
        },
        {
          "type": "max_tool_calls",
          "max": 6
        }
      ],
      "expected": {
        "maxToolCalls": 6
      }
    }
  ]
}

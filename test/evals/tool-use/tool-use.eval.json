      "seed": {
        "files": {}
      },
      "settings": {
        "ignoredGlobs": ""
      },
      "checks": [
        {
          "type": "answer_contains",
          "text": "^[^\\d\\-−—]*51(?!\\d)[\\s\\S]*$",
          "regex": true
        },
        {
          "type": "max_tool_calls",
          "max": 0
        }
      ]
    },

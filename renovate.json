{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "prHourlyLimit": 0,
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "description": "vitest and @vitest/* peer each other; a split bump fails npm install with ERESOLVE (#163/#165)",
      "groupName": "vitest",
      "matchPackageNames": ["vitest", "@vitest/**"],
      "separateMajorMinor": false,
      "separateMultipleMajor": false
    },
    {
      "description": "pi-agent-core nests its own pi-ai copy; a lone bump splits the AssistantMessageEventStream class (#154/#156)",
      "groupName": "earendil-works",
      "matchPackageNames": ["@earendil-works/**"],
      "separateMajorMinor": false,
      "separateMultipleMajor": false
    }
  ]
}

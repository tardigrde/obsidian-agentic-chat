# The gates are part of the merge contract. This file names who owns them, so
# GitHub requests the owner's review on a PR that changes a workflow, a gate
# script, or the lane table. "Require review from Code Owners" stays OFF on
# purpose: the owner is also the PR author, and GitHub never counts a
# self-approval (decided 2026-11-17, #393). The owner reads the diff before "merge".
/.github/workflows/ @tardigrde
/.github/CODEOWNERS @tardigrde
/scripts/verify.mjs @tardigrde
/scripts/verify-lanes.mjs @tardigrde
/scripts/verify-witness.mjs @tardigrde
/scripts/witness-from-pr.mjs @tardigrde
/scripts/check-*.mjs @tardigrde
/test/manifest.json @tardigrde

{
  "name": "obsidian-agentic-chat",
  "version": "1.0.0-rc.8",
  "description": "Agent-led AI chat in the Obsidian right sidebar, powered by OpenRouter, Ollama, or OpenAI-compatible gateways.",
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/build.mjs",
    "install:local": "tsx scripts/install-local.ts",
    "install:android": "node scripts/install-android-plugin.mjs",
    "dev:vault": "tsx scripts/install-local.ts --watch",
    "dogfood": "tsx scripts/dogfood.ts",
    "worktree:new": "node scripts/worktree.mjs new",
    "worktree:env": "node scripts/worktree.mjs env",
    "worktree:list": "node scripts/worktree.mjs list",
    "worktree:cleanup": "node scripts/worktree.mjs cleanup",
    "hooks:install": "node scripts/install-hooks.mjs",
    "eval:tool-use": "node --import tsx scripts/run-tool-use-evals.ts",
    "eval:ab": "node --import tsx scripts/eval-ab.ts",
    "eval:explain": "node --import tsx scripts/eval-explain.ts",
    "eval:significance": "node --import tsx scripts/run-tool-use-evals.ts --compare --significance",
    "fixture:serve": "tsx scripts/eval/fixture-server.ts",
    "fixture:mcp": "tsx scripts/eval/fixture-mcp-server.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build": "npm run typecheck && node scripts/build.mjs production && node scripts/verify-release.mjs && node scripts/verify-mobile-compat.mjs",
    "build:e2e": "node scripts/build-e2e.mjs",
    "typecheck": "node scripts/tsc7.mjs -noEmit",
    "typecheck:e2e": "node scripts/tsc7.mjs -p tsconfig.e2e.json --noEmit",
    "lint": "eslint .",
    "lint:comments": "node scripts/comment-budget.mjs",
    "knip": "knip --no-progress",
    "lint:obsidian": "eslint -c config/eslint.obsidian.mjs --max-warnings 0 src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "eval:provider-cache-live": "node scripts/eval-provider-cache-live.mjs",
    "verify:provider-live": "node scripts/verify-provider-live.mjs",
    "analyze:session": "node scripts/analyze-session-trace.mjs",
    "trace:mine": "tsx scripts/eval/trace-miner.ts",
    "eval:from-trace": "tsx scripts/eval/trace-to-case.ts",
    "verify": "node scripts/verify.mjs",
    "nested": "node scripts/run-nested.mjs",
    "verify:witness": "node scripts/verify-witness.mjs",
    "capture:release-fixtures": "node scripts/capture-release-fixtures.mjs",
    "check:feature-map": "node scripts/check-feature-map.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:css-tokens": "node scripts/check-css-tokens.mjs",
    "check:cycles": "node scripts/check-cycles.mjs",
    "logs:prune": "node scripts/logs-prune.mjs",
    "tests:status": "node scripts/tests-status.mjs",
    "delegate": "bash scripts/delegate.sh",
    "chaos:mine": "tsx scripts/chaos/mine.ts",
    "pretest:e2e": "npm run build:e2e",
    "test:e2e": "node --import tsx scripts/run-e2e.ts",
    "pretest:e2e:mobile": "npm run build:e2e",
    "test:e2e:mobile": "node scripts/run-e2e-mobile.mjs",
    "test:e2e:matrix": "node scripts/run-e2e-matrix.mjs",
    "verify:mobile": "node scripts/verify-mobile-compat.mjs",
    "mutation": "stryker run",
    "check:remote-mcp": "node --import tsx scripts/check-remote-mcp.ts"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "ai",
    "agent",
    "openrouter",
    "chat"
  ],
  "author": "tardigrde",
  "license": "MIT",
  "release": {
    "branches": ["main"],
    "tagFormat": "${version}",
    "repositoryUrl": "git@github.com:tardigrde/obsidian-agentic-chat.git",
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits",
          "releaseRules": [{ "breaking": true, "release": "minor" }]
        }
      ],
      ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
      [
        "@semantic-release/exec",
        { "prepareCmd": "node scripts/version-bump.mjs ${nextRelease.version} && npm run build" }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "package-lock.json",
            "manifest.json",
            "versions.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": [
            { "path": "main.js" },
            { "path": "manifest.json" },
            { "path": "styles.css" }
          ]
        }
      ]
    ]
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@wdio/cli": "^10.2.0",
    "@wdio/globals": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.7.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "knip": "^6.48.0",
    "madge": "^8.0.0",
    "mocha": "12.0.3",
    "obsidian": "^1.7.2",
    "obsidian-launcher": "3.5.0",
    "pdfjs-dist": "4.10.38",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "^8.72.2",
    "undici": "^8.12.4",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0",
    "wdio-obsidian-reporter": "3.5.0",
    "wdio-obsidian-service": "3.5.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "typebox": "1.4.6"
  },
  "overrides": {
    "@electron/get": {
      "undici": "8.12.4"
    },
    "cheerio": {
      "undici": "8.12.4"
    },
    "js-yaml": "4.3.2",
    "moment": "2.31.0",
    "serialize-javascript": "7.1.4",
    "vitepress": {
      "vite": "6.4.6"
    },
    "webdriverio": {
      "undici": "8.12.4"
    },
    "qs": "^6.17.1",
    "fast-xml-parser": "^5.12.0",
    "minimatch@>=7 <11.0.1": "^11.0.1",
    "glob@>=9 <14.0.2": "14.0.3"
  },
  "allowScripts": {
    "esbuild": true,
    "@google/genai": false,
    "classic-level": false,
    "edgedriver": false,
    "geckodriver": false,
    "protobufjs": false
  }
}
